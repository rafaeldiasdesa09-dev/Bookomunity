<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Explore - Bookomunity</title>

    <link rel="stylesheet" href="/css/search.css">
    <link rel="stylesheet" href="/css/partial/header.css">
    <link rel="stylesheet" href="/css/partial/posts.css">
</head>

<body>
    <%- include('partial/header') %>
    <script src="/js/header.js"></script>
    <%- include('partial/dottedBg') %>

    <main>
    <% if (type === 'livro') { %>
        <section class="row">
            <h2 class="row-title">RESULTADOS</h2>

            <div class="row-posts">
                <% if (dados.length === 0) { %>
                    <p class="empty-message">
                        Nenhum livro encontrado.
                    </p>
                <% } else { %>
                    <div class="card-area">
                    <% dados.forEach(item => { %>
                            <a style="text-decoration: none; color: #777067" href="/api/livros/<%= item.id %>">
                            <div class="card">
                                <img class="card-capa" src="<%= item.capa %>">
                                <div class="content">
                                    <h3 class="card-title"><%= item.titulo %></h3>
                                    <p class="card-autor"><%= item.autor %></p>
                                </div>
                            </div>
                            </a>
                    <% }) %>
                    </div>
                <% } %>

            </div>
        </section>
        <% } %>

        <% if (type === 'postagem') { %>
                <section class="row">
                    <h2 class="row-title">RESULTADOS</h2>

                    <div class="row-posts">
                        <% if (dados.length === 0) { %>
                            <p class="empty-message">
                                Nenhuma postagem encontrada.
                            </p>
                        <% } else { %>
                            <div class="post-card-area">
                            <% dados.forEach(item => { %>

                                <% if (item.tipo === 'DISCUSSAO') { %>
                                    <%- include('partial/posts/discussion', { item }) %>

                                <% } else if (item.tipo === 'RESENHA') { %>
                                    <%- include('partial/posts/resenha', { item }) %>

                                <% } else if (item.tipo === 'RECOMENDACOES') { %>
                                    <%- include('partial/posts/recomendations', { item }) %>

                                <% } else { %>
                                    <%- include('partial/posts/common', { item }) %>
                                <% } %>

                            <% }) %>
                            </div>
                        <% } %>

                    </div>
                </section>
            <% } %>

        <% if (type === 'usuario') { %>
            <section class="row">
                <h2 class="row-title">RESULTADOS</h2>

                <div class="row-posts">
                    <% if (dados.length === 0) { %>
                        <p class="empty-message">
                            Nenhum usuário encontrado.
                        </p>
                    <% } else { %>
                        <div class="user-card-area">
                        <% dados.forEach(item => { %>
                                <a style="text-decoration: none; color: #777067" href="/user/<%= item.nome_usuario %>">
                                <div class="user-card">
                                    <img class="user-card-avatar" src="<%= item.foto_perfil %>">
                                    <div class="user-content">
                                        <h3 class="user-card-name"><%= item.nome %></h3>
                                        <p class="user-card-bio"><%= item.bio %></p>
                                    </div>
                                </div>
                                </a>
                        <% }) %>
                        </div>
                    <% } %>
            
                </div>
            </section>
        <% } %>

        <% if (type === 'clube') { %>
            <section class="row">
                <h2 class="row-title">RESULTADOS</h2>

                <div class="row-posts">
                    <% if (dados.length === 0) { %>
                        <p class="empty-message">
                            Nenhum clube encontrado.
                        </p>
                    <% } else { %>
                        <div class="user-card-area">
                        <% dados.forEach(item => { %>
                                <a style="text-decoration: none; color: #777067" href="/clubes/<%= item.id %>">
                                <div class="user-card">
                                    <img class="user-card-avatar" src="<%= item.imagem %>">
                                    <div class="user-content">
                                        <h3 class="user-card-name"><%= item.nome %></h3>
                                        <p class="user-card-description"><%= item.descricao %></p>
                                    </div>
                                </div>
                                </a>
                        <% }) %>
                        </div>
                    <% } %>
            
                </div>
            </section>
        <% } %>
    </main>
    <script src="/js/explore.js"></script>
</body>
</html>