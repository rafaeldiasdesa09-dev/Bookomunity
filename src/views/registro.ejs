<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro - Bookomunity</title>
    <link rel="stylesheet" href="/css/registro.css">
    <link rel="stylesheet" href="/css/partial/header.css">
</head>
<body>
    <%- include('partial/header') %>
    <script src="/js/header.js"></script>

    <div class="sky">
      <div class="stars"></div>
      <div class="stars2"></div>
      <div class="stars3"></div>
    </div>

    <main class="container" style="margin-top: 60px;">

        <% if (typeof flash !== 'undefined' && flash) { %>
            <div class="flash"><%= flash %></div>
        <% } %>

        <div class="card">
            <h2>Crie sua conta Bookomunity</h2>
            <form method="POST" action="/auth/registro" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="nome">Nome *</label>
                    <input type="text" id="nome" placeholder="Seu Nome" name="nome" required>
                </div>

                <div class="form-group">
                    <label for="nome_usuario">Nome de Usuário *</label>
                    <input type="text" id="nome_usuario" name="nome_usuario" placeholder="seunome" required>
                </div>

                <div class="form-group">
                    <label for="email">Email *</label>
                    <input type="email" id="email" name="email" placeholder="seunome@email.com" required>
                </div>

                <div class="form-group">
                    <label for="senha">Senha *</label>
                    <input type="password" id="senha" name="senha" minlength="6" placeholder="Mínimo de 6 caractéres" required>
                </div>

                <div class="form-group">
                    <div class="file-input-div">
                        <label style="width: 100%; height: 2rem; text-align: center; line-height: 2rem; margin-bottom: 0; background-color: rgba(255,255,255,0); cursor: pointer;" for="foto">Adicione um arquivo aqui</label>
                        <input style="-webkit-appearance: none; appearance: none;" type="file" id="foto" name="foto" accept="image/*">
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Criar Conta</button>
            </form>

            <div class="link">
                Já tem conta? <a href="/login">Fazer login</a>
            </div>
        </div>
    </main>
</body>
</html>