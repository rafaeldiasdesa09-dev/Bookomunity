    <div class="dimming" id="dimming"></div>
    <div id="search-box-parent" style="flex-direction: column; position: fixed; top: 0; left: 0; display: none; align-items: center; justify-content: center; width: 100vw; height: 100vh; z-index: 1231;">
        <div class="search-box" id="search-box">
            <form action="/search" method="get">
                <div class="search-bar">
                    <input class="search-bar-text" name="q" type="text" placeholder="Pesquise aqui por livros, pessoas, postagens, etc.">
                    <button class="search-bar-btn" type="submit">
                        <img style="height: 1.5rem; opacity: .3;" src="/img/icon/search.svg">
                    </button>
                </div>
                
                <div class="search-categories">             
                    <div class="opcao">
                        <input type="radio" id="usuario" name="filter" value="usuario" checked>
                        <label for="usuario">Usuário</label>
                    </div>

                    <div class="opcao">
                        <input type="radio" id="livro" name="filter" value="livro">
                        <label for="livro">Livro</label>
                    </div>

                    <div class="opcao">
                        <input type="radio" id="postagem" name="filter" value="postagem">
                        <label for="postagem">Postagem</label>
                    </div>

                    <div class="opcao">
                        <input type="radio" id="clube" name="filter" value="clube">
                        <label for="clube">Clube</label>
                    </div>
                </div>
            </form>
        </div>
        <p id="quit-search" style="cursor: pointer; color: white; margin-top: .5rem;">Clique aqui para sair.</p>
    </div>

<div class="header-box">
    <a href="/explore">
        <img src="<%= (page == '/register' || page == '/login') ? '/img/Bookomunity_White.png' : '/img/Bookomunity_Black.png' %>" class="logo" alt="Bookomunity">
    </a>
    <header>
        <% if (page !== '/create-post') { %>
        <button type="button" id="search-bar" class="header-btn">
            <img 
            class="header-btn-img" 
            src="/img/icon/search.svg"
            alt="Pesquisar">
        </button>
        <% } %>

        <button type="button" data-url="explore" class="header-btn header-link">
            <img 
            class="header-btn-img" 
            src="/img/icon/explore.svg"
            alt="Explorar">
        </button>

        <% if (nome === 'bibliotecario') { %>
        <button type="button" data-url="create-book" class="header-btn header-link">
            <img 
            class="header-btn-img" 
            src="/img/icon/create.svg"
            alt="Criar">
        </button>
        <% } else { %>
            <button type="button" data-url="create-post" class="header-btn header-link">
                <img 
                class="header-btn-img" 
                src="/img/icon/create.svg"
                alt="Criar">
            </button>
        <% } %>
        
        <% if (nome !== undefined && nome !== null) { %>
        <% if (nome !== 'bibliotecario') { %>
        <button type="button" data-url="friends" class="header-btn header-link">
            <img 
            class="header-btn-img" 
            src="/img/icon/friends.svg"
            alt="Amizades">
        </button>
        <% } %>
            <button type="button" data-url="user" data-id="<%= sessionUserName %>" class="header-btn header-link">
                <img 
                class="header-btn-img" 
                src="<%= typeof foto !== 'undefined' && foto ? foto : '/img/icon/default-avatar.svg' %>"
                alt="Seu Perfil">
            </button>
            <% if (isOwner) { %>
            <form action="/auth/logoff" method="POST" style="display: inline;">
                <button type="submit" class="header-login header-link">Sair</button>
            </form>
            <% } %>
        <% } else { %>
            <button type="button" data-url="login" class="header-login header-link">Entrar</button>
        <% } %>
    </header>
</div>

<div class="blur">
</div>