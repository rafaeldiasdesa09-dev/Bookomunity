
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#49352b">
    <title>Meu perfil | Bookomunity</title>
    <link rel="stylesheet" href="/css/user.css">
    <link rel="stylesheet" href="/css/partial/header.css">
    <link rel="stylesheet" href="/css/partial/posts.css">

</head>
<body>
    <%- include('partial/header') %>
    <script src="/js/header.js"></script>
    <%- include('partial/dottedBg') %>

    <main class="page-container">
        <section class="profile-card">
            <div class="profile-cover">
                <span class="cover-decoration decoration-one">✦</span>
                <span class="cover-decoration decoration-two">❧</span>
                <span class="cover-quote" id="coverQuote">“Entre páginas, encontramos novos mundos.”</span>
            </div>
                <div class="avatar-wrap">
                    <img
                        class="profile-avatar"
                        src="<%= typeof fotoUsuario !== 'undefined' && fotoUsuario ? fotoUsuario : '/img/icon/default-avatar.svg' %>"
                        alt="Foto de perfil"
                        onerror="this.onerror=null;this.src='/img/logoBookomunity2.png';"
                    >
                </div>

            <div class="profile-main">


                <div class="profile-identity">
                    <div class="user-info">
                        <h1 style="margin-bottom: 1rem;">
                            <%= typeof nomeExibicao !== 'undefined' && nomeExibicao ? nomeExibicao : 'Leitor do Bookomunity' %>
                        </h1>
                        <p class="username" style="margin-bottom: .8rem; margin-left: 0rem;">@<%= nomeUsuario %></p>
                        <% if (!isOwner && nome) { %>
                            <form id="form-add-friend" action="/api/amizades" method="post">
                                <input style="display: none;" name="usuario_id" type="number" value="<%= sessionId %>">
                                <input style="display: none;" name="amigo_id" type="number" value="<%= id %>">
                                <button class="add-btn" id="submit-add-friend" type="submit">
                                    <img style="max-width: 1rem; max-height: 1rem;" src="/img/icon/add.svg">
                                </button>
                            </form>
                            <p id="request-sent" style="color: rgb(93, 197, 140); margin-bottom: 1rem; display: none;">Pedido enviado com sucesso!</p>
                        <% } %>
                    </div>


                    <div class="profile-bio-container">
                        <% if (isOwner) { %>
                        <button type="button" class="btn-editar-bio" id="btnEditarBio">
                            Editar biografia
                        </button>
                        <% } %>
                        <p class="profile-bio" id="bioTexto"><% if (bio) {%><%= bio %><%}%></p>
                        <% if (isOwner) { %>
                        <form class="form-bio" id="formBio" style="display: none;">
                            <textarea
                                class="bio-input"
                                name="bio"
                                id="bioInput"
                                maxlength="1000"
                                placeholder="Escreva sua biografia..."></textarea>

                            <button class="btn-editar-bio" type="submit">Salvar</button>
                            <button class="btn-editar-bio" type="button" id="btnCancelarBio">Cancelar</button>
                        </form>
                        <% } %>
                </div>
            </div>
            </div>
            <div style="margin-top: 1rem;"></div>
            <div class="profile-stats">

                <div class="stat">
                    <strong><%= typeof minhasPostagens !== 'undefined' && Array.isArray(minhasPostagens) ? minhasPostagens.length : 0 %></strong>
                    <span>Publicações</span>
                </div>

                <div class="stat">
                    <strong><%= typeof amigos !== 'undefined' && Array.isArray(amigos) ? amigos.length : 0 %></strong>
                    <span>Amigos</span>
                </div>

                <div class="stat">
                    <strong><%= typeof clubes !== 'undefined' && Array.isArray(clubes) ? clubes.length : 0 %></strong>
                    <span>Clubes</span>
                </div>
            </div>
        </section>

        <div class="profile-content">

<section class="content-section">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">IDEIAS QUE COMPARTILHO</p>
                        <h2>Minhas publicações</h2>
                    </div>
                    <span class="section-symbol" aria-hidden="true">✎</span>
                </div>

                <div class="row-posts">
                    <% if (typeof minhasPostagens !== 'undefined' && Array.isArray(minhasPostagens) && minhasPostagens.length > 0) { %>
                        <div class="post-card-area">
                            <% minhasPostagens.forEach(function(postagem) { %>
                                <% 
                                    // Define os fallbacks para foto, nome de exibição e nome de usuário
                                    const fallbackFoto = typeof fotoUsuario !== 'undefined' && fotoUsuario ? fotoUsuario : '/img/icon/default-avatar.svg';
                                    const fallbackNomeExibicao = typeof nomeExibicao !== 'undefined' && nomeExibicao ? nomeExibicao : 'Leitor do Bookomunity';
                                    const fallbackNomeUsuario = typeof nomeUsuario !== 'undefined' && nomeUsuario ? nomeUsuario : '';
                                    const fallbackCapaLivro = typeof capa_livro !== 'undefined' && capa_livro ? capa_livro : '';

                                    const postItem = { 
                                        ...postagem, 
                                        foto_perfil: postagem.foto_perfil || postagem.foto || fallbackFoto,
                                        nome_exibicao: postagem.nome_exibicao || fallbackNomeExibicao,
                                        nome: postagem.nome || fallbackNomeUsuario,
                                        capa_livro: postagem.capa_livro || fallbackCapaLivro,
                                    }; 
                                %>

                                <% if (postItem.tipo === 'DISCUSSAO') { %>
                                    <%- include('partial/posts/discussion', { item: postItem }) %>

                                <% } else if (postItem.tipo === 'RESENHA') { %>
                                    <%- include('partial/posts/resenha', { item: postItem }) %>

                                <% } else if (postItem.tipo === 'RECOMENDACOES') { %>
                                    <%- include('partial/posts/recomendations', { item: postItem }) %>

                                <% } else { %>
                                    <%- include('partial/posts/common', { item: postItem }) %>
                                <% } %>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <h3>Nada por aqui por enquanto...</h3>
                            <p>Assim que esse usuário tiver publicações, elas aparecerão aqui!</p>
                        </div>
                    <% } %>
                </div>
            </section>            <div class="community-grid">
                <section class="content-section">
                    <div class="section-heading">
                        <div>
                            <p class="eyebrow">COMPANHIA DE LEITURA</p>
                            <h2>Meus amigos</h2>
                        </div>
                        <span class="section-symbol" aria-hidden="true">♡</span>
                    </div>

                    <div class="community-list">
                        <% if (typeof amigos !== 'undefined' && Array.isArray(amigos) && amigos.length > 0) { %>
                            <% amigos.forEach(function(amigo) { %>
                                <article class="person-item">
                                    <img
                                        src="<%= amigo.foto_perfil || amigo.foto || '/img/icon/default-avatar.svg' %>"
                                        alt=""
                                        class="person-avatar"
                                        onerror="this.onerror=null;this.src='/img/logoBookomunity2.png';"
                                    >

                                    <div>
                                        <h3><%= amigo.nome || 'Leitor' %></h3>
                                        <p>Leitor da comunidade</p>
                                    </div>
                                </article>
                            <% }) %>
                        <% } else { %>
                            <div class="mini-empty">
                                <p>Seus amigos leitores aparecerão aqui.</p>
                                <a class="text-link" href="/friends">Conhecer a área de amizades</a>
                            </div>
                        <% } %>
                    </div>
                </section>

                <section class="content-section">
                    <div class="section-heading">
                        <div>
                            <p class="eyebrow">LEITURA EM GRUPO</p>
                            <h2>Meus clubes</h2>
                        </div>
                        <span class="section-symbol" aria-hidden="true">⌂</span>
                    </div>

                    <div class="community-list">
                        <% if (typeof clubes !== 'undefined' && Array.isArray(clubes) && clubes.length > 0) { %>
                            <% clubes.forEach(function(clube) { %>
                                <article class="club-item">

                                    <div>
                                        <h3><%= clube.nome || 'Clube de leitura' %></h3>
                                        <p><%= clube.descricao || 'Um espaço para compartilhar leituras.' %></p>
                                    </div>
                                </article>
                            <% }) %>
                        <% } else { %>
                            <div class="mini-empty">
                                <p>Os clubes dos quais você participa aparecerão aqui.</p>
                                <a class="text-link" href="/friends">Explorar a comunidade</a>
                            </div>
                        <% } %>
                    </div>
                </section>
            </div>
        </div>

        <footer class="page-footer">
            <p>Bookomunity — um mundo inteiro entre páginas.</p>
        </footer>
    </main>
    <script src="/js/user.js"></script>
</body>
</html>
