<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bookomunity - Amizades</title>
    <link rel="stylesheet" href="/css/amizades.css">
    <link rel="stylesheet" href="/css/partial/header.css">
</head>

<body>
    <%- include('partial/header') %>
    <%- include('partial/dottedBg') %>

    <main class="main-container">

        <!-- Apresentação -->
        <section class="welcome-section">
            <div>
                <span class="section-tag">COMUNIDADE BOOKOMUNITY</span>
                <h1>Suas amizades e clubes</h1>
                <p>
                    Conecte-se com outros leitores, gerencie suas solicitações
                    e acompanhe os clubes de leitura dos quais você faz parte.
                </p>
            </div>
            <div class="welcome-icon">
                <span>♧</span>
            </div>
        </section>

        <!-- Navegação por Abas -->
        <nav class="tabs-nav">
            <button class="tab-btn active" data-tab="amigos">
                Meus amigos
            </button>
            <button class="tab-btn" data-tab="solicitacoes">
                Solicitações
            </button>
            <button class="tab-btn" data-tab="clubes">
                Meus clubes
            </button>
        </nav>

        <!-- Meus amigos -->
        <section class="content-section active" id="amigos">
            <div class="section-header">
                <div>
                    <h2>Meus amigos</h2>
                    <p>Leitores com quem você já está conectado.</p>
                </div>
            </div>
            <div class="cards-container" id="listaAmigos">
                <div class="empty-state">
                    <div class="empty-icon">♧</div>
                    <h3>Carregando amigos...</h3>
                </div>
            </div>
        </section>

        <!-- Solicitações -->
        <section class="content-section" id="solicitacoes">
            <div class="section-header">
                <div>
                    <h2>Solicitações de amizade</h2>
                    <p>Veja quem deseja se conectar com você.</p>
                </div>
            </div>
            <div class="cards-container" id="listaSolicitacoes">
                <div class="empty-state">
                    <div class="empty-icon">✉</div>
                    <h3>Carregando solicitações...</h3>
                </div>
            </div>
        </section>

        <!-- Meus Clubes -->
        <section class="content-section" id="clubes">
            <div class="section-header">
                <div>
                    <h2>Meus clubes de leitura</h2>
                    <p>Veja os clubes dos quais você participa ou crie um novo grupo.</p>
                </div>
                <button style="margin-top: 1rem;" class="primary-btn" id="btnAbrirFormulario">
                    Criar clube
                </button>
            </div>

            <!-- Formulário de criação -->
            <div id="formularioClube" style="display: none;">
                <form class="formCriarClube" id="formCriarClube">
                    <div class="campo">
                        <label for="nomeClube">Nome do clube</label>
                        <input
                            type="text"
                            id="nomeClube"
                            name="nome"
                            placeholder="Nome do seu clube"
                            maxlength="100"
                            required>

                        <label for="descricaoClube">Descrição</label>
                        <textarea
                            id="descricaoClube"
                            name="descricao"
                            placeholder="Conte um pouco sobre seu clube...">
                        </textarea>

                        <label class="imagemClube primary-btn" for="fotoClube">Imagem do clube</label>
                        <input
                            type="file"
                            id="fotoClube"
                            name="foto"
                            accept="image/*"
                            style="display: none;"
                        >
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="primary-btn">Criar clube</button>
                        <button type="button" id="btnCancelarClube" class="reject-btn primary-btn">Cancelar</button>
                    </div>

                    <p id="mensagemClube"></p>
                </form>
            </div>

            <!-- Lista de clubes -->
            <div class="cards-container" id="listaMeusClubes">
                <div class="empty-state">
                    <div class="empty-icon">📚</div>
                    <h3>Carregando seus clubes...</h3>
                </div>
            </div>
        </section>

    </main>

    <!-- Script do Frontend -->
    <script src="/js/amizades.js"></script>
    <script src="/js/header.js"></script>
</body>
</html>