
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Explore - Bookomunity</title>

    <link rel="stylesheet" href="/css/explore.css">
    <link rel="stylesheet" href="/css/partial/header.css">
    <link rel="stylesheet" href="/css/partial/posts.css">
</head>

<body>
    <%- include('partial/header') %>
    <script src="/js/header.js"></script>
    <%- include('partial/dottedBg') %>

    <main>
        <h1 style="margin-bottom: 2rem; width: calc(100vw-12rem); text-align: center; color: rgb(119, 119, 100); font-family: Georgia, 'Times New Roman', Times, serif;">Olá, bem-vindo ao Bookomunity.</h1>
<% if (userName) { %>

        <!-- Postagens de outros usuários -->
        <section class="row">
            <h2 class="row-title">POSTAGENS DE AMIGOS</h2>

            <div class="row-posts">

                <% if (typeof postagensAmigos !== 'undefined' && postagensAmigos.length > 0) { %>

                    <% postagensAmigos.forEach(postagem => { %>

                        <article class="post-card">
                            <h3><%= postagem.titulo %></h3>
                            <p><%= postagem.conteudo %></p>
                        </article>

                    <% }) %>

                <% } else { %>

                    <p class="empty-message">
                        Ainda não existem postagens de amigos para mostrar.
                    </p>

                <% } %>

            </div>
        </section>
<% } %>

<!-- Recomendação de livros -->
<section class="row">
    <h2 class="row-title">LIVROS PARA VOCÊ</h2>

    <div class="row-posts">

        <% if (typeof livros !== 'undefined' && livros.length > 0) { %>

            <% livros.forEach(livro => { %>

                <article class="post-card">

                    <% if (livro.capa) { %>
                        <img
                            src="<%= livro.capa %>"
                            alt="Capa de <%= livro.titulo %>"
                        >
                    <% } %>

                    <h3><%= livro.titulo %></h3>

                    <p>
                        Autor: <%= livro.autor || 'Não informado' %>
                    </p>

                    <% if (livro.descricao) { %>
                        <p><%= livro.descricao %></p>
                    <% } %>

                </article>

            <% }); %>

        <% } else { %>

            <p class="empty-message">
                Nenhum livro cadastrado ainda.
            </p>

        <% } %>

    </div>
</section>


    </main>
    <script src="/js/explore.js"></script>
</body>
</html>