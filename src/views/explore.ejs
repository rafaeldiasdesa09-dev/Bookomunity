<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EXPLORE-CONCEITO</title>
    <link rel="stylesheet" href="css/explore.css">    
</head>

    <header>
        <div class="logo">
            <img src="/img/logoBookomunity2.png" alt="Logo Bookomunity">
        </div>

        <nav>
            <a href="/">Início</a>
            <a href="/explore">Explorar</a>
            <a href="/login">Entrar</a>        </nav>
    </header>


<body>
    <section class="row">
            <h2 class="row-title">SUAS POSTAGENS</h2>
            <div class="row-posts">
                </div> 
        </section>

        <section class="row">
            <h2 class="row-title">POSTAGENS DE AMIGOS</h2>
            <div class="row-posts">
                </div> 
        </section>

        <% if (typeof nome !== 'undefined' && nome) { %>
            <div class="user-info">
          
              <a href="/logoff"
                 style="color: #E74C3C; margin-left: .5rem;">
                Sair
              </a>
          
              <a href="/profile"
                 class="user"
                 style="margin-left: 1rem; font-weight: 700;">
                <%= nome %>
              </a>
          
              <img
                id="avatar-header"
                alt="Foto de perfil de: <%= nome %>"
                class="user-avatar"
                src="<%= typeof foto !== 'undefined' && foto ? foto : '/img/avatar-padrao.png' %>"
              >
          
            </div>
          <% } %>
</body>
</html>