<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Criar postagem</title>
  <link href="/css/createpost.css" rel="stylesheet">
  <link href="/css/partial/posts.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/partial/header.css">
</head>
<body>
    <%- include('partial/header') %>
    <script src="/js/header.js"></script>
    <%- include('partial/dottedBg') %>

  <div class="main">
    <div class="sidebar">
      <label for="common-button">Selecionar tipo de postagem</label>
      <button name="common-button" style="margin-top: 1rem;" type="button" id="common-button" class="select-button-discussion select-type">Discussão</button>

      <form action="/api/postagens" method="post">
        <input type="hidden" name="clube_id" id="clube_id_input" value="<%= typeof clubeIdSelecionado !== 'undefined' && clubeIdSelecionado ? clubeIdSelecionado : '' %>">

        <% if (typeof clubeIdSelecionado !== 'undefined' && clubeIdSelecionado) { %>
            <div id="clube-badge-info" style="background: #fdf6ec; border: 1px solid var(--gold); padding: 8px 10px; border-radius: 6px; font-size: 0.85rem; display: flex; justify-content: space-between; align-items: center;">
                <span>Clube: <strong><%= typeof clubeNome !== 'undefined' && clubeNome ? clubeNome : ('#' + clubeIdSelecionado) %></strong></span>
                <button type="button" id="btn-remover-clube" style="background: none; border: none; color: #a94442; cursor: pointer; font-weight: bold; font-size: 0.8rem;">(Remover)</button>
            </div>
        <% } %>

        <input style="display: none;" name="tipo" value="DISCUSSAO">
        
        <label for="select-book">Referenciar livro *</label>
        <button name="select-book" type="button" id="btn-selecionar-livro" class="common-button">Selecionar</button>

        <label for="avaliacao" style="display: none;">Avaliação *</label>
        <input type="number" name="avaliacao" min="1" max="5" placeholder="Avaliação (1 a 5)" style="display: none;" autocomplete="off">
        
        <input type="hidden" name="livro_id" id="livro_id">
        <input type="hidden" name="capa_livro" id="capa_livro">
        <input type="hidden" name="titulo_livro" id="titulo_livro">

        <label for="titulo">Título da postagem *</label>
        <input name="titulo" type="text" placeholder="Título da postagem" maxlength="100">
        
        <label for="conteudo">Conteúdo da postagem *</label>
        <textarea name="conteudo" placeholder="Conteúdo da postagem" maxlength="1000"></textarea>
        
        <button type="submit" class="common-button">Postar</button>
      </form>
    </div>

    <main>
      <h1 class="preview-title">Pré-visualização</h1>
      <%- include('partial/posts/discussion') %>
      <%- include('partial/posts/resenha') %>
      <%- include('partial/posts/recomendations') %>
      <%- include('partial/posts/common') %>
    </main>
  </div>

  <script src="/js/createPost.js"></script>
</body>
</html>