<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Criar postagem - Bookomunity</title>
  <link rel="stylesheet" href="/css/createPost.css">
</head>
<body>
  <header class="topbar">
    <a href="/explore" class="back-link">← Voltar para Explore</a>
    <span class="brand">Bookomunity</span>
  </header>

  <main class="page">
    <section class="form-card">
      <p class="eyebrow">COMPARTILHE COM A COMUNIDADE</p>
      <h1>Criar postagem</h1>
      <p class="subtitle">
        Compartilhe suas opiniões, converse e indique suas próximas leituras.
      </p>

      <!-- Formulário com envio tradicional (POST padrão) -->
      <form id="create-post-form" action="/api/postagens" method="POST">
        
        <label for="tipo">Tipo de postagem</label>
        <select id="tipo" name="tipo" required>
          <option value="DISCUSSAO">Discussão</option>
          <option value="REVIEW">Avaliação de livro</option>
          <option value="RECOMENDAÇAO">Recomendação de livro</option>
        </select>

        <div id="book-field" class="field">
          <label for="livro_id">Livro relacionado</label>
          <select id="livro_id" name="livro_id">
            <option value="">Selecione um livro</option>
            <% livros.forEach(livro => { %>
              <option value="<%= livro.id %>">
                <%= livro.titulo %><%= livro.autor ? " — " + livro.autor : "" %>
              </option>
            <% }) %>
          </select>
          <small id="book-help">Opcional para discussões.</small>
        </div>

        <div id="rating-field" class="field" hidden>
          <label for="avaliacao">Sua nota (de 0 a 5)</label>
          <select id="avaliacao" name="avaliacao">
            <option value="">Selecione uma nota</option>
            <option value="0">0 — Não gostei</option>
            <option value="0.5">0,5</option>
            <option value="1">1</option>
            <option value="1.5">1,5</option>
            <option value="2">2</option>
            <option value="2.5">2,5</option>
            <option value="3">3</option>
            <option value="3.5">3,5</option>
            <option value="4">4</option>
            <option value="4.5">4,5</option>
            <option value="5">5 — Excelente</option>
          </select>
        </div>

        <label for="titulo">Título</label>
        <input
          id="titulo"
          name="titulo"
          type="text"
          maxlength="200"
          placeholder="Dê um título à sua postagem"
          required
        >

        <label for="conteudo">Conteúdo</label>
        <textarea
          id="conteudo"
          name="conteudo"
          rows="7"
          placeholder="Escreva aqui..."
          required
        ></textarea>

        <div class="form-actions">
          <a href="/explore" class="cancel-button">Cancelar</a>
          <button type="submit" id="submit-button">Publicar postagem</button>
        </div>
      </form>
    </section>
  </main>

  <!-- Script mantido apenas para a interatividade visual dos campos -->
  <script>
    const tipo = document.getElementById("tipo");
    const bookField = document.getElementById("book-field");
    const livro = document.getElementById("livro_id");
    const bookHelp = document.getElementById("book-help");
    const ratingField = document.getElementById("rating-field");
    const avaliacao = document.getElementById("avaliacao");

    function atualizarCampos() {
      const isReview = tipo.value === "REVIEW";
      const isRecommendation = tipo.value === "RECOMENDAÇAO";
      const precisaDeLivro = isReview || isRecommendation;

      bookField.hidden = false;
      livro.required = precisaDeLivro;
      bookHelp.textContent = precisaDeLivro
        ? "Selecione o livro relacionado à postagem."
        : "Opcional para discussões.";

      ratingField.hidden = !isReview;
      avaliacao.required = isReview;

      if (!isReview) {
        avaliacao.value = "";
      }
    }

    tipo.addEventListener("change", atualizarCampos);
    atualizarCampos();
  </script>
</body>
</html>