<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link href="/css/createpost.css" rel="stylesheet">
  <link href="/css/partial/posts.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/partial/header.css">
</head>
<body>
    <%- include('partial/header') %>
    <script src="/js/header.js"></script>
    <%- include('partial/dottedBg') %>

  <div class="main">
  <div class="sidebar">
    <label for="common-button">Selecionar tipo de postagem</label>
    <button name="common-button" style="margin-top: 1rem;" type="button" id="common-button" class="common-button">Discussão</button>

    <form action="/api/postagens" method="post">
      <input style="display: none;" name="tipo" value="DISCUSSAO">
      <label for="select-book">Referenciar livro *</label>
      <button name="select-book" type="button" id="common-button" class="common-button">Selecionar</button>
      <label for="titulo">Título da postagem *</label>
      <input name="titulo" type="text" placeholder="Título da postagem" maxlength="100">
      <label for="conteudo">Conteúdo da postagem *</label>
      <textarea name="conteudo" type="text" placeholder="Conteúdo da postagem" maxlength="1000"></textarea>
      
      <button type="submit" class="common-button">Postar</button>
    </form>
  </div>

  <main>
    <!-- discussão -->
    <div class="post discussion-post" id="discussion-post">
      <div class="post-header">
        <img src="<%= foto %>" class="userpfp">
        <strong class="user-name"><%= nome_exibicao %></strong>
        <span class="user-username" style="margin-left: -.4rem;">@<%= nome %></span>
        <p class="post-type">Discussão</p>
      </div>
      <div class="discussion-post-top">
        <div class="photo">
        </div>

        <div class="post-content">
          <h1 class="post-book-title">Livro</h1>
          <h3 class="post-title">Título</h3>
          <p class="post-text">Corpo da postagem</p>
        </div>
      </div>
      

      <div class="discussion-post-bottom">
        <div class="post-bottom-left">
          <p>324.324 curtidas</p><p>641 comentários</p>
        </div>
        
        <div class="post-bottom-right">
          <p>opções</p>
        </div>
      </div>

    </div>


    <!-- resenha -->
    <div class="post resenha-post" id="resenha-post">
      <div class="post-header">
        <img src="<%= foto %>" class="userpfp">
        <strong class="user-name"><%= nome_exibicao %></strong>
        <span class="user-username" style="margin-left: -.4rem;">@<%= nome %></span>
        <p class="post-type">Resenha</p>
      </div>
      <div class="resenha-post-top">
        <div class="photo">
        </div>

        <div class="post-content">
          <h1 class="post-book-title">Livro</h1>
          <strong class="post-rating">5 estrelas</strong>
          <h3 class="post-title">Título</h3>
          <p class="post-content">Conteúdo da postagem</p>
        </div>
      </div>
      

      <div class="resenha-post-bottom">
        <div class="post-bottom-left">
          <p>214.001 curtidas</p><p>2.118 comentários</p>
        </div>
        
        <div class="post-bottom-right">
          <p>opções</p>
        </div>
      </div>

    </div>


    <!-- recomendações -->
    <div class="post recomendation-post"  id="recomendation-post">
      <div class="post-header">
        <img src="<%= foto %>" class="userpfp">
        <strong class="user-name"><%= nome_exibicao %></strong>
        <span class="user-username" style="margin-left: -.4rem;">@<%= nome %></span>
        <p class="post-type">Recomendações</p>
      </div>
      <div class="recomendation-post-top">

        <div class="post-content">
          <h3 class="post-title">Título</h3>
          
        </div>
         
      </div>
      

      <div class="recomendation-post-bottom">
        <div class="recomendation-post-bottom-header">
          <p>237 respostas, 43 livros recomendados</p>
        </div>
        <div class="bookline">
          <div class="block" id="add-block" style="cursor: pointer;">
            <img src="/img/icon/add.svg" style="width: 1.5rem; opacity: .5; user-select: none;" alt="adicionar">
          </div>
        </div>
      </div>

    </div>


    <!-- comum -->
    <div class="post common-post" id="common-post">
      <div class="post-header">
        <img src="<%= foto %>" class="userpfp">
        <strong class="user-name"><%= nome_exibicao %></strong>
        <span class="user-username" style="margin-left: -.4rem;">@<%= nome %></span>
      </div>
      <div class="common-post-top">

        <div class="post-content">
          <h1 class="post-book-title">Livro</h1>
          <h3 class="post-title">Título</h3>
          <p class="post-content">Conteúdo da postagem</p>
        </div>
      </div>
      

      <div class="common-post-bottom">
        <div class="post-bottom-left">
          <p>1.218 curtidas</p><p>19 comentários</p>
        </div>
        
        <div class="post-bottom-right">
          <p>opções</p>
        </div>
      </div>

    </div>
  </main>
  </div>

  <script src="/js/createPost.js"></script>
</body>
</html>